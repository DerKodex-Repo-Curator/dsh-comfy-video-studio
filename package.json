{
  "name": "dsh-comfy-video-studio",
  "version": "0.6.1",
  "description": "Full-screen MiniMax H3 video studio for DeepSeek Harness backed by a local ComfyUI server",
  "author": {
    "name": "a1303845406",
    "url": "https://github.com/a1303845406"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "comfyui",
    "minimax-h3",
    "video-generation"
  ],
  "homepage": "https://github.com/a1303845406/dsh-comfy-video-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a1303845406/dsh-comfy-video-studio.git"
  },
  "bugs": {
    "url": "https://github.com/a1303845406/dsh-comfy-video-studio/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "assets/workflows",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "undici": "^6.21.3",
    "ws": "^8.18.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-connection": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-layout": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-theme": {
      "optional": true
    }
  },
  "scripts": {
    "generate:workflows": "node scripts/generate-workflows.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test:integration": "node scripts/integration-test.mjs",
    "prepack": "npm run build && npm run check",
    "pack:plugin": "npm pack --pack-destination dist"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
